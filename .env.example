# ─── Backend API ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ─── Cloudinary upload script (scripts/cloudinary/upload-assets.mjs) ────────
# Node-only credentials for the one-off migration upload. NEVER add a VITE_
# prefix to these: VITE_* values are embedded in the public browser bundle.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
