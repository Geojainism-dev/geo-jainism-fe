# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ignore lock files
package-lock.json
yarn.lock
pnpm-lock.yaml

# production build output
/dist
/build

# firebase
.firebase/
.firebaserc

# local temporary files
# upload-assets.mjs writes this and renames it over upload-results.json; it survives only if a run crashes mid-save
/scripts/cloudinary/results/upload-results.json.tmp
# Vite writes a bundled config next to vite.config.js while loading it; left behind if Vite is killed
/vite.config.js.timestamp-*
# Claude Code per-user settings (the tracked .claude/skills/ stay tracked)
/.claude/settings.local.json

# archives
*.zip
*.tar.gz
*.tgz
*.rar

